# Copy to .env (project root) and adjust. Never commit real secrets.

# --- Server ---------------------------------------------------------------
APP_ENV=development              # "production" disables /api/docs
LOG_LEVEL=INFO
# Signs download links. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to use a random key per process (links stop working after a restart).
SECRET_KEY=
# Origins allowed to call the API cross-origin. Not needed on Render/Docker, where the
# API serves the UI itself; only add a URL if you host the UI on another origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex for extra origins, e.g. ^https://ui(-[a-z0-9-]+)?\.example\.com$
CORS_ORIGIN_REGEX=
SERVE_FRONTEND=true              # serve frontend/dist from the API server when built
TRUST_PROXY_HEADERS=false        # true only behind exactly one trusted proxy (Render, Railway, Fly.io, nginx)

# --- Home hosting (docker compose) ------------------------------------------------
# Password for the whole app (browser login; any username). Set it before exposing the app
# through a Cloudflare Tunnel or any public URL.
ACCESS_PASSWORD=
HOST_PORT=8000                   # http://localhost:<HOST_PORT>
CLOUDFLARE_TUNNEL_TOKEN=         # only for: docker compose --profile tunnel up -d

# --- Storage & retention ----------------------------------------------------
TEMP_DIR=./backend/tmp
RETENTION_MINUTES=60             # finished jobs and their files are deleted after this
CLEANUP_INTERVAL_SECONDS=120
DOWNLOAD_LINK_TTL_MINUTES=60

# --- Limits -----------------------------------------------------------------
MAX_CONCURRENT_JOBS=2
MAX_ACTIVE_JOBS_PER_CLIENT=3
MAX_CONCURRENT_FFMPEG=2
INFO_RATE_LIMIT_PER_MINUTE=30
JOB_RATE_LIMIT_PER_MINUTE=10
INFO_TIMEOUT_SECONDS=45
JOB_TIMEOUT_SECONDS=10800
MAX_DURATION_SECONDS=14400
MAX_FILESIZE_MB=8192

# --- External tools ---------------------------------------------------------
FFMPEG_PATH=                     # empty = find "ffmpeg" on PATH
FFPROBE_PATH=
X264_PRESET=veryfast             # only used when a re-encode to H.264 is required
X264_CRF=20
YTDLP_JS_RUNTIMES=deno,node      # yt-dlp needs one; Deno is installed by requirements.txt

# --- YouTube bot checks ("Sign in to confirm you're not a bot") ---------------
# Mostly needed on cloud/datacenter servers. See README: "YouTube bot checks".
# PO-token provider: "bgutil" needs the bgutil-ytdlp-pot-provider plugin and its server.
# The Docker image bundles both and sets POT_PROVIDER=bgutil automatically.
POT_PROVIDER=none
BGUTIL_BASE_URL=http://127.0.0.1:4416
BGUTIL_SERVER_SCRIPT=            # path to server build/main.js to have the app start it
# cookies.txt (Netscape format) from SECONDARY YouTube and/or Instagram accounts (one file for both)
YTDLP_COOKIES_FILE=
# Outbound proxy for YouTube and Instagram traffic: http://user:pass@host:port or socks5://host:1080
YTDLP_PROXY=
YTDLP_PLAYER_CLIENTS=            # optional, e.g. mweb,web_safari (empty = yt-dlp default)

# --- Speech-to-text fallback (optional) ---------------------------------------
# none | openai_compatible | faster_whisper
STT_PROVIDER=none
# openai_compatible: any POST {base}/audio/transcriptions server returning verbose_json
STT_API_BASE_URL=https://api.openai.com/v1
STT_API_KEY=your-api-key-here
STT_MODEL=whisper-1
STT_TIMEOUT_SECONDS=600
STT_CHUNK_SECONDS=600
STT_MAX_DURATION_SECONDS=7200
# faster_whisper (pip install -r backend/requirements-stt-local.txt)
STT_LOCAL_MODEL=small
STT_LOCAL_DEVICE=auto
STT_LOCAL_COMPUTE_TYPE=default
